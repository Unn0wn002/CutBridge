{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutbridge.invalid/schema/release-index-v1.json",
  "title": "CutBridge Release Index",
  "type": "object",
  "required": ["schema_version", "releases"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string"},
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "channel",
          "blender_version_min",
          "release_page_url"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "channel": {
            "enum": ["stable", "beta", "development"]
          },
          "blender_version_min": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
          },
          "blender_version_max": {
            "type": ["string", "null"],
            "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
          },
          "platforms": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "release_page_url": {
            "type": "string",
            "minLength": 1
          },
          "download_url": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
